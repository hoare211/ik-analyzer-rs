from __future__ import annotations
from typing import List, Optional, Protocol, overload
from enum import Enum

class AstralMode(Enum):
    """补充平面（astral，码点 > U+FFFF）字符的处理模式。"""

    Drop = ...
    """全部非 BMP 字符丢弃（= IK 2012_u6 严格口径；`Tokenizer.u6_parity()` 钉此值）"""

    Ideographs = ...
    """**默认**：CJK 扩展 B–I 识别为汉字，其余补充平面字符（emoji 等）丢弃"""

    Tokens = ...
    """全部非 BMP 字符输出为单字 `CN_CHAR` 词元（机制对齐 analysis-ik）"""

class Lexeme:
    """分词结果对象。

    注意：`start` / `end` 是 **byte（UTF-8）偏移**，不是 Python 字符下标，
    因此可直接用于 `text[start:end]` 定位原文。Python 用户若按 code point
    理解下标会出错，请注意区分。
    """

    text: str
    """词元文本（**已归一化**：全角→半角，且默认 ASCII 小写化）"""
    start: int
    """起始 **byte** 偏移（含）"""
    end: int
    """结束 **byte** 偏移（不含）"""
    lexeme_type: str
    """词元类型名（如 "CN_WORD"、"ARABIC"）"""

